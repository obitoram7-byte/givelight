rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid);
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'displayName',
            'photoURL',
            'language',
            'publicProfileMode',
            'publicNickname',
            'showLocation',
            'country',
            'city',
            'isAnonymous',
            'updatedAt'
          ]);
      allow delete: if owns(uid) || isAdmin();
    }

    match /paymentMethods/{methodId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.status == 'ACTIVE' || isAdmin();
      allow write: if isAdmin();
    }

    match /publicStats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboardSnapshots/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /transparencyUpdates/{updateId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    match /contributionClaims/{claimId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.createdByUid == request.auth.uid);
      allow write: if false;
    }

    match /fundLedger/{ledgerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /lightPoints/{pointId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /founderContributions/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}